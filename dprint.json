{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "indentWidth": 4,
  "typescript": {
    "lineWidth": 120
  },
  "json": {
    "indentWidth": 2
  },
  "malva": {
    "printWidth": 120,
    "indentWidth": 4,
    "hexColorLength": "long",
    "formatComments": true,
    "linebreakInPseudoParens": true,
    "nthPlusSpacing": true,
    "preferSingleLine": true
  },
  "markup": {
    "printWidth": 120,
    "indentWidth": 4,
    "formatComments": true,
    "scriptIndent": true,
    "styleIndent": true,
    "closingTagLineBreakForEmpty": "never",
    "preferAttrsSingleLine": true,
    "svelteAttrShorthand": true,
    "svelteDirectiveShorthand": true
  },
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
    "**/*.svg"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.23.0",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.3"
  ]
}
